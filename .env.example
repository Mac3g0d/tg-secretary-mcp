# Токен бота от @BotFather (обязателен для команд serve и bot)
TELEGRAM_BOT_TOKEN=

# Путь к базе SQLite
TG_DB_PATH=data/secretary.db

# Сохранять сообщения только из этих чатов (ID через запятую). Пусто — из всех, где есть бот.
TG_ALLOWED_CHATS=

# Разрешить агентам отправлять сообщения от имени бота (инструмент send_message)
TG_ALLOW_SEND=false

# Адрес MCP-сервера (Streamable HTTP, эндпоинт /mcp)
MCP_ADDR=127.0.0.1:8080

# Bearer-токен для MCP. Обязателен, если MCP_ADDR не localhost.
MCP_AUTH_TOKEN=

# Необязательно: адрес собственного Bot API сервера
# TELEGRAM_API_URL=http://localhost:8081
