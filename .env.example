# Токен бота от @BotFather (обязателен для команд serve и bot)
TELEGRAM_BOT_TOKEN=

# Путь к базе SQLite
TG_DB_PATH=data/secretary.db

# Сохранять сообщения только из этих чатов (ID через запятую). Пусто — из всех, где есть бот.
TG_ALLOWED_CHATS=

# Разрешить агентам отправлять сообщения от имени бота (инструмент send_message)
TG_ALLOW_SEND=false

# Адрес MCP-сервера (Streamable HTTP, эндпоинт /mcp)
MCP_ADDR=127.0.0.1:8080

# Токен доступа: Bearer для MCP и пароль (HTTP Basic, любой логин) для веб-интерфейса.
# Обязателен, если MCP_ADDR не localhost.
MCP_AUTH_TOKEN=

# Веб-интерфейс просмотра и поиска на том же адресе (http://MCP_ADDR/)
WEB_UI=true

# Необязательно: адрес собственного Bot API сервера
# TELEGRAM_API_URL=http://localhost:8081

# Каталог для JSON-экспортов личных чатов больше 8 МБ (инструмент import_chat_export;
# экспорты поменьше агент передаёт прямо в вызове). "off" отключает импорт.
# TG_IMPORT_DIR=data/import
