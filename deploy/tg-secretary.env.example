# Пример env-файла для systemd.
# Копируется в /etc/tg-secretary/tg-secretary.env, права 600, владелец root.
# Формат EnvironmentFile: KEY=VALUE, без "export" и без комментариев в конце строки.

# Токен бота от @BotFather (обязателен)
TELEGRAM_BOT_TOKEN=

# Абсолютный путь к базе. Каталог /var/lib/tg-secretary создаёт systemd (StateDirectory).
TG_DB_PATH=/var/lib/tg-secretary/secretary.db

# Адрес HTTP-сервера. 127.0.0.1:8080 доступен только с этого компьютера.
# Для доступа из локальной сети: 0.0.0.0:8080 (тогда MCP_AUTH_TOKEN обязателен).
MCP_ADDR=127.0.0.1:8080

# Токен доступа: Bearer для /mcp и пароль HTTP Basic (любой логин) для веб-интерфейса.
# Сгенерировать: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Веб-интерфейс на том же адресе
WEB_UI=true

# Сохранять только эти чаты (ID через запятую). Пусто: все чаты, где есть бот.
TG_ALLOWED_CHATS=

# Разрешить агентам отправлять сообщения от имени бота (инструмент send_message)
TG_ALLOW_SEND=false

# Необязательно: собственный сервер Bot API
# TELEGRAM_API_URL=http://localhost:8081
