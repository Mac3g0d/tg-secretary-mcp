# systemd unit для tg-secretary.
# Установка: см. docs/deployment.md
#
#   sudo cp tg-secretary.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tg-secretary

[Unit]
Description=tg-secretary: Telegram bot archive and MCP server
Documentation=https://github.com/mac3g0d/tg-secretary-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tg-secretary
Group=tg-secretary
EnvironmentFile=/etc/tg-secretary/tg-secretary.env

# Данные лежат в /var/lib/tg-secretary (создаётся systemd). Бинарник читает .env
# из рабочей директории, а TG_DB_PATH по умолчанию относительный, поэтому
# в env-файле TG_DB_PATH задан явно.
StateDirectory=tg-secretary
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tg-secretary
ExecStart=/usr/local/bin/tg-secretary serve

# Бот завершается при недоступной сети в момент старта: перезапускаем.
Restart=on-failure
RestartSec=5

# Ограничения
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# База содержит личную переписку: файлы доступны только владельцу.
UMask=0077

[Install]
WantedBy=multi-user.target
